{
  "name": "carcassonne",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "@types/node": "^26.4.1",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.7.7",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@trpc/client": "^11.18.0",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @carcassonne/db --",
    "db:studio": "turbo run db:studio -F @carcassonne/db --",
    "db:generate": "turbo run db:generate -F @carcassonne/db --",
    "db:migrate": "turbo run db:migrate -F @carcassonne/db --",
    "deploy:setup": "bunx vercel link",
    "dev:vercel": "bunx vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "bunx vercel deploy",
    "deploy:prod": "bunx vercel deploy --prod",
    "deploy:check": "bunx vercel deploy --dry",
    "build:vercel": "bunx vercel build",
    "test": "turbo run test",
    "test:server": "turbo run test -F @carcassonne/api -F server",
    "db:seed": "turbo run db:seed -F server --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@carcassonne/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "packageManager": "bun@1.3.14"
}
