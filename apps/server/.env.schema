# Server environment (varlock). Values come from apps/server/.env locally and from Vercel project
# env vars in deployments (Neon via the Vercel Marketplace injects DATABASE_URL / DATABASE_URL_UNPOOLED).
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Set to "1" by Vercel in deployments.
# @internal @required=false
VERCEL=

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# Also the HMAC key for guest tokens.
# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=$VERCEL_ORIGIN

# @type=url
CORS_ORIGIN=$VERCEL_ORIGIN

# Pooled Postgres URL (Neon pooler in production).
# @type=string(minLength=1)
DATABASE_URL=

# Direct (unpooled) Postgres URL, used for LISTEN/NOTIFY fan-out. Falls back to DATABASE_URL.
# @required=false
DATABASE_URL_UNPOOLED=

# Job scheduler: "vercel" (Vercel Queues) or "local" (in-process timers). Default: vercel when VERCEL=1.
# @required=false @sensitive=false @type=enum(vercel, local)
SCHEDULER=

# Game engine: "fake" (test stand-in) or "wasm" (core.wasm via the CONTRACT ABI). Default: fake.
# @required=false @sensitive=false @type=enum(fake, wasm)
ENGINE=

# Path to core.wasm when ENGINE=wasm (default: packages/core/zig-out/bin/core.wasm).
# @required=false @sensitive=false
CORE_WASM_PATH=

# Engine version recorded on new games when ENGINE=wasm.
# @required=false @sensitive=false
ENGINE_VERSION=

# Kill switches (PRD §7.3). Edge Config keys `forcePolling` / `pauseOnline` override these when EDGE_CONFIG is set.
# @required=false @sensitive=false @type=boolean
FORCE_POLLING=false

# @required=false @sensitive=false @type=boolean
PAUSE_ONLINE=false

# Edge Config connection string (injected by Vercel when an Edge Config store is connected).
# @required=false
EDGE_CONFIG=

# Comma-separated account emails allowed to call admin.usage.
# @required=false @sensitive=false
ADMIN_EMAILS=

# Local dev port (ignored on Vercel).
# @required=false @sensitive=false @type=port
PORT=3000
