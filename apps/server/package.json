{
  "name": "server",
  "type": "module",
  "main": "api/server.ts",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "bun run --hot api/server.ts",
    "start": "bun api/server.ts",
    "test": "bun test",
    "db:seed": "bun scripts/seed.ts",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/auth-cli.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@carcassonne/api": "workspace:*",
    "@carcassonne/auth": "workspace:*",
    "@carcassonne/core-wasm": "workspace:*",
    "@carcassonne/db": "workspace:*",
    "@carcassonne/protocol": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "@sinclair/typebox": "^0.34.52",
    "@trpc/server": "catalog:",
    "@vercel/edge-config": "^1.5.1",
    "@vercel/functions": "^3.9.11",
    "@vercel/queue": "^0.8.0",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "^1.4.30",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@carcassonne/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
